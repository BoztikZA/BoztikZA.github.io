// Generates the two derived artefacts from learning/courses/*/course.json + rules.json:
//   src/learning/manifest.generated.ts   Worker-side rules (lesson ids, pass marks). NO answers.
//   learning/data/courses.json           public catalogue used by the Learning homepage.
//   npm run learning:build           write
//   npm run learning:build -- --check   fail if the committed files are stale (used by CI)
import { existsSync, mkdirSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";
import type { CourseRules, ExamQuestion } from "../src/learning/types.ts";
import { LEARNING_CATEGORIES } from "../src/learning/types.ts";

const here = dirname(fileURLToPath(import.meta.url));
const ROOT = join(here, "../../..");
const COURSES = join(ROOT, "learning/courses");
const OUT_TS = join(here, "../src/learning/manifest.generated.ts");
const OUT_JSON = join(ROOT, "learning/data/courses.json");
const check = process.argv.includes("--check");

const rules = JSON.parse(readFileSync(join(COURSES, "rules.json"), "utf8")) as Record<string, { passMark: number; practicalPassMark: number | null }>;
const slugs = readdirSync(COURSES, { withFileTypes: true }).filter((d) => d.isDirectory() && existsSync(join(COURSES, d.name, "course.json"))).map((d) => d.name).sort((a, b) => { const o = Object.keys(rules); const ia = o.indexOf(a), ib = o.indexOf(b); return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib) || a.localeCompare(b); }); // display order = key order in rules.json

const manifest: CourseRules[] = [];
const catalogue: Record<string, unknown>[] = [];
for (const slug of slugs) {
  const c = JSON.parse(readFileSync(join(COURSES, slug, "course.json"), "utf8"));
  if (c.slug !== slug) throw new Error(`${slug}: course.json slug mismatch`);
  if (!(LEARNING_CATEGORIES as readonly string[]).includes(c.category)) throw new Error(`${slug}: unknown category ${c.category}`);
  const r = rules[slug];
  if (!r || !(r.passMark > 0 && r.passMark <= 100)) throw new Error(`${slug}: missing/invalid rules.json entry`);
  const exam = (await import(pathToFileURL(join(here, "../src/learning/exams", `${slug}.ts`)).href)).questions as ExamQuestion[];
  const lessons = c.modules.flatMap((m: any) => m.lessons);
  manifest.push({
    slug, title: c.title, category: c.category, passMark: r.passMark, practicalPassMark: r.practicalPassMark,
    questionCount: exam.length, moduleIds: c.modules.map((m: any) => m.id), lessonIds: lessons.map((l: any) => l.id),
  });
  catalogue.push({
    slug, title: c.title, subtitle: c.subtitle, category: c.category, level: c.level, summary: c.summary,
    estimatedHours: c.estimatedHours, modules: c.modules.length, lessons: lessons.length,
    minutes: lessons.reduce((n: number, l: any) => n + (l.minutes || 0), 0),
    passMark: r.passMark, practicalPassMark: r.practicalPassMark, questionCount: exam.length,
  });
}

const ts = `// GENERATED by scripts/learning-build.mts from learning/courses/*. Do not edit by hand.\n// Contains lesson ids and pass marks only. Exam answers live in ./exams/* and are never generated here.\nimport type { CourseRules } from "./types";\n\nexport const COURSE_RULES: CourseRules[] = ${JSON.stringify(manifest, null, 2)};\n`;
const json = JSON.stringify({ version: 1, courses: catalogue }, null, 2) + "\n";

function sync(path: string, body: string) {
  const current = existsSync(path) ? readFileSync(path, "utf8") : null;
  if (check) { if (current !== body) { console.error(`STALE: ${path} — run npm run learning:build`); process.exitCode = 1; } return; }
  mkdirSync(dirname(path), { recursive: true });
  if (current !== body) writeFileSync(path, body);
  console.log(`${current === body ? "unchanged" : "wrote"} ${path}`);
}
sync(OUT_TS, ts);
sync(OUT_JSON, json);
