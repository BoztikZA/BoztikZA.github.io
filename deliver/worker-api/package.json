{
  "name": "boztik-deliver-api-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply boztik-deliver --local",
    "db:migrate:remote": "wrangler d1 migrations apply boztik-deliver --remote",
    "hash-password": "node scripts/hash-password.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:unit": "node scripts/milestone-test.mts",
    "test:delivery-list": "tsx scripts/delivery-list-params-test.mts",
    "test:retention": "node scripts/page-view-retention-test.mts",
    "test:traffic-source": "node scripts/traffic-source-test.mts",
    "test:analytics": "node scripts/analytics-pipeline-test.mts",
    "test:client": "node scripts/analytics-client-test.mjs",
    "test:spotlight": "tsx scripts/spotlight-test.mts",
    "test:spotlight-admin": "tsx scripts/spotlight-admin-test.mts",
    "test:spotlight-email": "tsx scripts/spotlight-email-test.mts",
    "test:spotlight-form": "node scripts/spotlight-form-test.mjs",
    "test:spotlight-media": "tsx scripts/spotlight-media-test.mts && tsx scripts/spotlight-media-routes-test.mts && tsx scripts/spotlight-media-client-test.mts",
    "test": "npm run test:unit && npm run test:delivery-list && npm run test:retention && npm run test:traffic-source && npm run test:analytics && npm run test:client && npm run test:spotlight && npm run test:spotlight-admin && npm run test:spotlight-email && npm run test:spotlight-form && npm run test:spotlight-media && npm run test:spotlight-owner && npm run test:spotlight-analytics && npm run test:spotlight-seo && npm run test:spotlight-featured && npm run learning:check && npm run test:learning-content && npm run test:learning",
    "test:spotlight-owner": "tsx scripts/spotlight-owner-test.mts",
    "test:spotlight-analytics": "tsx scripts/spotlight-analytics-test.mts && tsx scripts/spotlight-analytics-client-test.mts",
    "test:spotlight-seo": "tsx scripts/spotlight-seo-test.mts",
    "test:spotlight-featured": "tsx scripts/spotlight-rotation-test.mts",
    "test:learning-content": "tsx scripts/learning-content-test.mts",
    "test:learning": "tsx scripts/learning-test.mts",
    "learning:build": "tsx scripts/learning-build.mts",
    "learning:check": "tsx scripts/learning-build.mts --check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.0",
    "esbuild": "0.28.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "pdf-lib": "1.17.1"
  }
}
